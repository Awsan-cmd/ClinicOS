{
  "name": "clinicos",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "clinicos",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=26.0.0",
        "npm": ">=11.0.0"
      }
    },
    "apps/api": {
      "name": "@clinicos/api",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@clinicos/web",
      "version": "0.1.0"
    },
    "apps/worker": {
      "name": "@clinicos/worker",
      "version": "0.1.0"
    },
    "node_modules/@clinicos/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@clinicos/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@clinicos/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@clinicos/types": {
      "resolved": "packages/types",
      "link": true
    },
    "node_modules/@clinicos/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@clinicos/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "packages/config": {
      "name": "@clinicos/config",
      "version": "0.1.0"
    },
    "packages/contracts": {
      "name": "@clinicos/contracts",
      "version": "0.1.0"
    },
    "packages/types": {
      "name": "@clinicos/types",
      "version": "0.1.0"
    }
  }
}
